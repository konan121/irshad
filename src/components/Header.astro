---
import { href, site } from '../lib/episodes';
interface Props {
  variant?: 'hero' | 'compact';
  current?: 'home' | 'about' | 'episode';
}
const { variant = 'compact', current } = Astro.props;
---
<header class:list={['band', `band-${variant}`, 'on-dark']}>
  <div class="wrap band-top">
    {variant === 'compact' ? (
      <a class="brand" href={href()}>
        <span class="brand-mark" aria-hidden="true"></span>
        {site.name}
      </a>
    ) : (
      <span class="brand-spacer" aria-hidden="true"></span>
    )}
    <nav class="nav" aria-label="القائمة الرئيسية">
      <a href={href()} aria-current={current === 'home' ? 'page' : undefined}>الحلقات</a>
      <a href={href('about/')} aria-current={current === 'about' ? 'page' : undefined}>عن الركن</a>
    </nav>
  </div>
  <slot />
</header>

<style>
  .band {
    position: relative;
    color: #fff;
    background-color: var(--plum);
    background-image:
      radial-gradient(circle at 12% 18%, rgba(255, 255, 255, 0.12) 0, rgba(255, 255, 255, 0) 32%),
      radial-gradient(circle at 92% 110%, rgba(226, 169, 59, 0.28) 0, rgba(226, 169, 59, 0) 38%),
      linear-gradient(118deg, var(--plum) 0%, #7d1d61 48%, var(--raspberry) 100%);
    overflow: hidden;
    isolation: isolate;
  }
  .band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgba(255, 255, 255, 0.09) 1.2px, transparent 1.3px);
    background-size: 20px 20px;
    mask-image: linear-gradient(90deg, #000, transparent 70%);
    -webkit-mask-image: linear-gradient(90deg, #000, transparent 70%);
  }
  .band-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 10px 0;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    text-decoration: none;
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    min-height: 44px;
  }
  .brand-mark {
    width: 10px;
    height: 26px;
    border-radius: 4px;
    background: linear-gradient(var(--gold), #f3cf86);
  }
  .nav { display: flex; gap: 4px; margin-inline-start: auto; }
  .nav a {
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    padding: 6px 14px;
    border-radius: 999px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    opacity: 0.92;
  }
  .nav a:hover { background: rgba(255, 255, 255, 0.12); opacity: 1; }
  .nav a[aria-current='page'] {
    background: rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);
    opacity: 1;
  }
  .band-compact { border-bottom: 3px solid var(--gold); }
  .band-compact .band-top { padding-block: 8px; }
  .band-hero { border-bottom: 4px solid var(--gold); }
  @media (max-width: 560px) {
    .brand { font-size: 18px; }
    .nav a { padding: 6px 12px; font-size: 14.5px; }
  }
</style>
