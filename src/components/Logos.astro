---
import { href, site } from '../lib/episodes';
// الترتيب في RTL: وزارة التعليم يمينًا، المدرسة في الوسط، رؤية عُمان 2040 يسارًا.
const dims: Record<string, [number, number]> = { moe: [393, 140], school: [106, 192], vision: [210, 140] };
---
<div class="logos">
  <div class="logos-in wrap">
    {site.logos.map((logo) => (
      <img
        class={`logo logo-${logo.key}`}
        src={href(`img/logos/${logo.key}.webp`)}
        alt={logo.alt}
        width={dims[logo.key][0]}
        height={dims[logo.key][1]}
        decoding="async"
      />
    ))}
  </div>
</div>

<style>
  .logos {
    background: #fff;
    border-bottom: 3px solid var(--gold);
  }
  .logos-in {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding-block: 10px;
  }
  .logo { width: auto; }
  .logo-moe { height: 54px; justify-self: start; }
  .logo-school { height: 74px; justify-self: center; }
  .logo-vision { height: 54px; justify-self: end; }
  @media (max-width: 560px) {
    .logos-in { padding-block: 8px; gap: 8px; }
    .logo-moe { height: 36px; max-width: 100%; object-fit: contain; }
    .logo-school { height: 52px; }
    .logo-vision { height: 38px; }
  }
</style>
