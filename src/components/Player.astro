---
// المشغّل لا يحمّل iframe الخاص بـ Drive إلا بعد الضغط على الغلاف، حفاظًا على سرعة الصفحة على شبكة الجوال.
import { type Episode, posterSrc, drivePreview } from '../lib/episodes';
import { arDuration } from '../lib/ar';
interface Props {
  ep: Episode;
  eager?: boolean;
  sizes?: string;
}
const { ep, eager = false, sizes = '(max-width: 1000px) 100vw, 960px' } = Astro.props;
---
<div class="player" data-player data-src={drivePreview(ep)} data-title={ep.title}>
  <button type="button" class="player-btn">
    <img
      src={posterSrc(ep, 960)}
      srcset={`${posterSrc(ep, 480)} 480w, ${posterSrc(ep, 960)} 960w`}
      sizes={sizes}
      alt=""
      width="960"
      height="540"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding={eager ? 'sync' : 'async'}
    />
    <span class="play-icon" aria-hidden="true"></span>
    <span class="play-label">تشغيل الحلقة<span class="sr-only">: {ep.title}،</span></span>
    <span class="dur num"><span class="sr-only">المدة </span>{arDuration(ep.duration)}</span>
  </button>
</div>

<script>
  function mount(player: HTMLElement) {
    const btn = player.querySelector<HTMLButtonElement>('.player-btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = player.dataset.src!;
      frame.title = `مشغّل الحلقة: ${player.dataset.title}`;
      frame.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.setAttribute('tabindex', '0');
      player.replaceChildren(frame);
      player.classList.add('is-playing');
      frame.focus({ preventScroll: true });
    });
  }
  document.querySelectorAll<HTMLElement>('[data-player]').forEach(mount);
</script>
