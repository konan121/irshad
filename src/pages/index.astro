---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Player from '../components/Player.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import Icon from '../components/Icon.astro';
import { episodes, tagsOf, totalMinutes, href, epPath, driveView, site } from '../lib/episodes';
import { arNum, arDate, arDuration, spokenDuration, episodesWord, minutesWord, episodesPhrase } from '../lib/ar';

const latest = episodes[0];
const counts = Object.fromEntries(
  site.templates.map((t) => [t, episodes.filter((e) => tagsOf(e).includes(t)).length])
);
const description = `فيديوهات إرشادية توعوية قصيرة بالعربية الفصحى لطالبات الصفوف ${site.grades} في ${site.school}، من إعداد الأخصائيتين الاجتماعيتين ${site.specialists.join(' و')}. ${site.hashtag}`;
---
<Base title={`${site.name} — ${site.school}`} description={description}>
  <Header slot="header" variant="hero" current="home">
    <div class="wrap hero">
      <div class="hero-text">
        <p class="eyebrow">سلسلة فيديوهات إرشادية توعوية</p>
        <h1>{site.name}</h1>
        <p class="school">{site.school} <span class="num" dir="rtl">({site.grades})</span></p>
        <p class="by">إعداد الأخصائيتين الاجتماعيتين: {site.specialists.join(' · ')}</p>
        <p class="tag"><span class="num" dir="rtl">{site.hashtag}</span></p>
      </div>
      <dl class="stats">
        <div class="stat">
          <dt>{episodesWord(episodes.length)}</dt>
          <dd class="num">{arNum(episodes.length)}</dd>
        </div>
        <div class="stat">
          <dt>{minutesWord(totalMinutes)} مشاهدة</dt>
          <dd class="num">{arNum(totalMinutes)}</dd>
        </div>
        <div class="stat">
          <dt>الصفوف</dt>
          <dd class="num" dir="rtl">{site.grades}</dd>
        </div>
      </dl>
    </div>
  </Header>

  <section class="wrap section latest" aria-labelledby="latest-title">
    <div class="featured">
      <Player ep={latest} eager sizes="(max-width: 860px) 100vw, 640px" />
      <div class="f-info">
        <p class="pill"><span class="dot" aria-hidden="true"></span>أحدث حلقة</p>
        <h2 id="latest-title">{latest.title}</h2>
        <div class="meta">
          <span class="chip">{latest.template}</span>
          <span class="mi"><Icon name="clock" /><span class="sr-only">المدة: {spokenDuration(latest.duration)}</span><span class="num" aria-hidden="true">{arDuration(latest.duration)}</span></span>
          <span class="mi"><Icon name="calendar" /><time datetime={latest.date}>{arDate(latest.date)}</time></span>
        </div>
        <p class="sum">{latest.summary}</p>
        <div class="f-actions">
          <a class="btn btn-primary" href={href(epPath(latest))}>
            <Icon name="play" />صفحة الحلقة والمشاركة
          </a>
          <a class="btn btn-soft" href={driveView(latest)} target="_blank" rel="noopener">
            <Icon name="download" />تحميل 1080p
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section library" id="episodes" aria-labelledby="all-title">
    <div class="section-head">
      <h2 id="all-title">كل الحلقات</h2>
      <span class="hint">من الأحدث إلى الأقدم</span>
    </div>

    <div class="toolbar">
      <div class="search">
        <label for="q" class="sr-only">ابحث في الحلقات بالعنوان أو الملخص</label>
        <Icon name="search" class="search-icon" />
        <input
          id="q"
          type="search"
          name="q"
          placeholder="ابحث بالعنوان أو الملخص…"
          autocomplete="off"
          enterkeyhint="search"
          spellcheck="false"
        />
      </div>
      <div class="filters" role="group" aria-label="تصفية الحلقات حسب القالب">
        <button type="button" class="fchip" data-tag="" aria-pressed="true">
          الكل <span class="count num">{arNum(episodes.length)}</span>
        </button>
        {site.templates.map((t) => (
          <button type="button" class="fchip" data-tag={t} aria-pressed="false" disabled={counts[t] === 0}>
            {t} <span class="count num">{arNum(counts[t])}</span>
          </button>
        ))}
      </div>
    </div>

    <p class="result" aria-live="polite" data-result>{episodesPhrase(episodes.length)}</p>

    <div class="grid" data-grid>
      {episodes.map((ep) => <EpisodeCard ep={ep} />)}
    </div>

    <div class="empty" data-empty hidden>
      <p>لا توجد حلقات مطابقة لبحثك.</p>
      <button type="button" class="btn btn-ghost" data-reset>عرض كل الحلقات</button>
    </div>
  </section>
</Base>

<script>
  import { normalizeArabic, episodesPhrase } from '../lib/ar';

  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.fchip'));
  const input = document.querySelector<HTMLInputElement>('#q')!;
  const result = document.querySelector<HTMLElement>('[data-result]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  let tag = '';
  let debounce: number | undefined;

  function apply(updateUrl = true) {
    const terms = normalizeArabic(input.value).split(' ').filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const tags = (card.dataset.tags || '').split('|');
      const text = card.dataset.search || '';
      const ok = (!tag || tags.includes(tag)) && terms.every((t) => text.includes(t));
      card.hidden = !ok;
      if (ok) shown++;
    }
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.tag === tag)));
    result.textContent = episodesPhrase(shown) + (tag ? ` — ${tag}` : '');
    empty.hidden = shown > 0;

    if (updateUrl) {
      const url = new URL(location.href);
      tag ? url.searchParams.set('t', tag) : url.searchParams.delete('t');
      input.value.trim() ? url.searchParams.set('q', input.value.trim()) : url.searchParams.delete('q');
      history.replaceState(null, '', url);
    }
  }

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      tag = chip.dataset.tag || '';
      apply();
    })
  );

  input.addEventListener('input', () => {
    window.clearTimeout(debounce);
    debounce = window.setTimeout(apply, 220);
  });
  input.closest('form')?.addEventListener('submit', (e) => e.preventDefault());
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') input.blur();
  });

  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    tag = '';
    input.value = '';
    apply();
    chips[0]?.focus();
  });

  const params = new URLSearchParams(location.search);
  const initialTag = params.get('t') || '';
  if (chips.some((c) => c.dataset.tag === initialTag)) tag = initialTag;
  input.value = params.get('q') || '';
  if (tag || input.value) {
    apply(false);
    if (location.hash !== '#episodes') document.getElementById('episodes')?.scrollIntoView();
  }
</script>

<style>
  /* ===== البانر ===== */
  .hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 22px 32px;
    flex-wrap: wrap;
    padding-block: 18px 34px;
  }
  .hero-text { display: grid; gap: 4px; justify-items: start; }
  .eyebrow {
    font-size: 14px;
    font-weight: 700;
    color: var(--gold-50);
    letter-spacing: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .eyebrow::before {
    content: '';
    width: 22px;
    height: 3px;
    border-radius: 3px;
    background: var(--gold);
  }
  .hero h1 {
    font-size: clamp(38px, 6vw, 56px);
    line-height: 1.2;
    text-shadow: 0 2px 18px rgba(46, 15, 51, 0.35);
  }
  .school { font-size: clamp(18px, 2.4vw, 22px); font-weight: 700; }
  .by { font-size: 15px; opacity: 0.92; }
  .tag {
    margin-top: 10px;
    display: inline-block;
    background: #fff;
    color: var(--plum);
    border: 2px solid var(--gold);
    border-radius: 999px;
    padding: 2px 16px;
    font-weight: 800;
    font-size: 15px;
    box-shadow: 0 6px 18px rgba(46, 15, 51, 0.22);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    min-width: min(100%, 380px);
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: rgba(255, 255, 255, 0.13);
    border: 1px solid rgba(255, 255, 255, 0.26);
    border-radius: 16px;
    padding: 10px 8px 8px;
  }
  .stat dd {
    margin: 0;
    font-family: var(--display);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.25;
  }
  .stat dt { font-size: 13.5px; opacity: 0.92; font-weight: 600; }

  @media (max-width: 640px) {
    .hero { padding-block: 10px 24px; justify-content: center; text-align: center; }
    .hero-text { justify-items: center; }
    .eyebrow::after { content: ''; width: 22px; height: 3px; border-radius: 3px; background: var(--gold); }
    .by { font-size: 14px; }
    .stats { width: 100%; min-width: 0; }
    .stat dd { font-size: 26px; }
    .stat dt { font-size: 12.5px; }
  }

  /* ===== أحدث حلقة ===== */
  .latest { padding-top: 26px; }
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 16px;
    box-shadow: var(--shadow-md);
  }
  .f-info { display: grid; gap: 12px; align-content: center; padding: 4px 4px 4px 8px; }
  .pill {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--gold-50);
    color: var(--plum);
    border: 1px solid #efd7a2;
    border-radius: 999px;
    padding: 2px 14px;
    font-weight: 800;
    font-size: 13.5px;
  }
  .pill .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--raspberry);
    box-shadow: 0 0 0 3px rgba(194, 24, 91, 0.2);
    animation: pulse 2s ease-out 3;
  }
  @keyframes pulse {
    70% { box-shadow: 0 0 0 8px rgba(194, 24, 91, 0); }
    100% { box-shadow: 0 0 0 0 rgba(194, 24, 91, 0); }
  }
  .f-info h2 { font-size: clamp(26px, 3vw, 34px); color: var(--plum); }
  .f-info .sum { color: var(--ink); font-size: 15.5px; line-height: 1.85; }
  .f-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }

  @media (max-width: 860px) {
    .featured { grid-template-columns: 1fr; gap: 16px; padding: 10px; }
    .f-info { padding: 2px 6px 8px; }
  }
  @media (max-width: 560px) {
    .latest { padding-top: 18px; }
    .f-actions { display: grid; grid-template-columns: 1fr; }
  }

  /* ===== البحث والتصفية ===== */
  .toolbar {
    display: grid;
    gap: 12px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 12px;
    box-shadow: var(--shadow-sm);
    margin-bottom: 12px;
  }
  .search { position: relative; }
  .search :global(.search-icon) {
    position: absolute;
    inset-inline-start: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    color: var(--muted);
    pointer-events: none;
  }
  .search input {
    width: 100%;
    min-height: 48px;
    border: 1.5px solid var(--line);
    background: var(--blush);
    border-radius: 12px;
    padding: 10px 46px 10px 14px;
    padding-inline-start: 46px;
    padding-inline-end: 14px;
    font-size: 16px;
    outline: none;
    transition: border-color 0.15s, background-color 0.15s;
    -webkit-appearance: none;
    appearance: none;
  }
  .search input::placeholder { color: #8a7590; }
  .search input:focus { border-color: var(--plum); background: #fff; }
  .search input:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }

  .filters {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 4px;
    margin: -4px;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
  }
  .filters::-webkit-scrollbar { display: none; }
  .fchip {
    flex: none;
    scroll-snap-align: start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--plum);
    font-weight: 700;
    font-size: 14.5px;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .fchip:hover { border-color: var(--plum); }
  .fchip .count {
    background: var(--blush-200);
    color: var(--plum);
    border-radius: 999px;
    min-width: 24px;
    padding: 0 7px;
    font-size: 12.5px;
    line-height: 1.6;
    text-align: center;
  }
  .fchip[aria-pressed='true'] { background: var(--plum); border-color: var(--plum); color: #fff; }
  .fchip[aria-pressed='true'] .count { background: rgba(255, 255, 255, 0.2); color: #fff; }
  .fchip:disabled { opacity: 0.45; cursor: not-allowed; }

  .result { color: var(--muted); font-size: 14px; font-weight: 600; margin: 4px 2px 12px; }

  .empty {
    display: grid;
    justify-items: center;
    gap: 12px;
    text-align: center;
    padding: 36px 16px;
    background: var(--card);
    border: 1.5px dashed var(--line);
    border-radius: var(--r-md);
    color: var(--muted);
  }
</style>
